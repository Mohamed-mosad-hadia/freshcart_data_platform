# =============================================================================
# FreshCart: settings of THE COMPANY. Do not change them: everybody must have
# exactly the same company (same dates, same size, same seed => same data).
# Add the settings of YOUR platform at the bottom.
# =============================================================================

# ---- The company's production database (you get READ-ONLY access) ----------
SOURCE_DB_USER=freshcart
SOURCE_DB_PASSWORD=freshcart
# your account for reading the data (user: analytics_reader)
SOURCE_READER_PASSWORD=reader

# ---- The exchange-rate provider: your API key (header X-API-Key) -------------
FX_API_KEY=freshcart-fx-key

# ---- The company's calendar (Cairo dates) -------------------------------------
COURSE_START_DATE=2026-10-13
COURSE_END_DATE=2026-10-26
HISTORY_DAYS=730

# ---- Company size -------------------------------------------------------------
ORDERS_PER_DAY=4000
N_CUSTOMERS=150000
N_PRODUCTS=120
SIM_SEED=42

# ---- (leave empty) ------------------------------------------------------------
SIM_FAKE_NOW=

# ---- YOUR PLATFORM: add your own settings below --------------------------------

# ---- ClickHouse data warehouse -------------------------------------------------
CLICKHOUSE_PASSWORD=freshcart_ch_pass
AIRFLOW_UID=50000

# ---- Gmail Alert Settings ------------------------------------------------------
